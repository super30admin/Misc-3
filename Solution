/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode() {}
 *     ListNode(int val) { this.val = val; }
 *     ListNode(int val, ListNode next) { this.val = val; this.next = next; }
 * }
 */

 // TC O(n)
 // SC O(1)

 // Using pointers to mark the start and end of k-sized groups and then reversing
class Solution {
    public ListNode reverseKGroup(ListNode head, int k) {

        if (head == null || k == 0) {
            return head;
        }
        
        
        ListNode dummy = new ListNode(-1);
        dummy.next = head;
        
        ListNode begin = dummy;
        int count = 0;
        ListNode current = head;
        
        while (current != null) {
            count++;
            if (count % k == 0) {
                begin = reverse(begin, current.next);
                current = begin.next;
            } else {
                current = current.next;
            }
        }
        
        return dummy.next;
    }
    
    private ListNode reverse(ListNode begin, ListNode end) {
        ListNode prev = null;
        ListNode curr = begin.next;
        ListNode first = curr;
        ListNode next = null;
        
        while (curr != end) {
            next = curr.next;
            curr.next = prev;
            prev = curr;
            curr = next;
        }
        
        
        begin.next = prev;
        first.next = end;
        
        return first;
    }        
    
}
